# Copy this to .env and adjust. Nothing here is secret in a localhost run
# except SESSION_SECRET, which must be set before this is exposed to anyone else.

# --- Server ---------------------------------------------------------------
PORT=8080
# Use 0.0.0.0 to allow other devices on the local network to connect.
# Keep 127.0.0.1 for access from this PC only.
HOST=0.0.0.0
NODE_ENV=development

# Required once NODE_ENV=production — the server refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Hours before a signed-in session expires
SESSION_HOURS=12
# Defaults to true in production. Keep true behind HTTPS; for an HTTP-only,
# trusted LAN deployment, set false or sign-in cookies will not be sent.
# HTTPS is strongly preferred when users sign in over a network.
SESSION_COOKIE_SECURE=

# --- Database -------------------------------------------------------------
# Create it first:  createdb approval_notes
# Use an administrator URL for the initial schema/seed and FDW setup. The
# FDW setup command replaces it with a restricted AppNote runtime login.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/approval_notes
PG_POOL_MAX=10
# Set to "require" when the database is remote and needs TLS
# PGSSL=require

# --- Source databases / FDW setup ----------------------------------------
# Supply these three elevated URLs to the one-time setup command from the
# current PowerShell session; do not save them in this file. The setup command
# creates a restricted AppNote runtime login and changes DATABASE_URL to use it.
# $env:FDW_SETUP_DATABASE_URL = '<admin URL to the AppNote database>'
# $env:REQFLOW_FDW_SETUP_URL = '<admin URL to the Reqflow database>'
# $env:SITEERP_FDW_SETUP_URL = '<admin URL to the SiteERP database>'
# Optional least-privilege URLs for db:check-sources only:
# REQFLOW_DATABASE_URL=postgresql://reader:password@localhost:5432/reqflow
# SITEERP_DATABASE_URL=postgresql://reader:password@localhost:5432/site_erp_v2
# AppNote generates scoped FDW role passwords and stores them in .env.
# SOURCE_PGSSL=require

# --- Company and numbering ------------------------------------------------
COMPANY_NAME=Dharti Dredging & Infrastructure Limited
# The note number is built as <NOTE_PREFIX>/<financial year>/<month>/<sequence>
NOTE_PREFIX=YG/ Port-Dharti
# GST state code of the company's own registration — 27 is Maharashtra.
# This decides CGST+SGST against IGST when the project has no state of its own.
COMPANY_STATE_CODE=27

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# --- Reading quotations ---------------------------------------------------
# off   manual entry only (recommended until extraction is validated)
# auto  try the PDF text layer, then OCR, then AI
# text  PDF text layer only
# ocr   OCR only
# ai    AI only
EXTRACTION_MODE=off

# Below this confidence the note warns loudly and pushes toward manual entry.
EXTRACTION_CONFIDENCE_FLOOR=45

# Optional. Without this the AI stage is skipped and the system falls back to
# OCR, then to manual entry. Only needed for photographs too poor for OCR.
# ANTHROPIC_API_KEY=
# AI_EXTRACTION_MODEL=claude-sonnet-4-6

# Where tesseract.js keeps its downloaded language data
# OCR_CACHE_PATH=./.ocr-cache

# --- Demo data ------------------------------------------------------------
# The password given to every seeded user by "npm run db:seed". Change it.
DEMO_PASSWORD=ChangeMe123!
